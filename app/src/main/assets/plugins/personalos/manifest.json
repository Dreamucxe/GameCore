{
  "minHostVersion": 37,
  "declares": [
    "theme",
    "screens",
    "widgets",
    "settings",
    "icon"
  ],
  "permissions": [
    {"id": "change_ui"},
    {"id": "add_dashboard_widgets"},
    {"id": "store_data"},
