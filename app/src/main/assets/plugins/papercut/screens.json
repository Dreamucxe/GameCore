    {
      "icon": "info",
      "id": "limits",
      "title": "Paper, Not A Texture",
      "content": {
        "children": [
          {
            "type": "text",
            "props": {
              "size": 20,
              "text": "What the paper is",
              "bold": true
            }
          },
          {
            "children": [
              {
                "type": "text",
                "props": {
                  "size": 16,
                  "text": "Colour and type",
                  "bold": true
                }
              },
              {
                "type": "text",
                "props": {
                  "size": 14,
                  "text": "The warm ground, cream surfaces, serif face and tight corners are the whole effect. A `.gcplugin` cannot ship a paper texture, a font file or an arbitrary image."
                }
              }
            ],
            "type": "card",
            "props": {
              "padding": 14,
              "color": "#FFFDF7",
              "gap": 8
            }
          },
          {
            "children": [
              {
                "type": "text",
                "props": {
                  "size": 16,
                  "text": "Why a light theme",
                  "bold": true
                }
              },
              {
                "type": "text",
                "props": {
                  "size": 14,
                  "text": "Some rooms and some eyes are better served by a light surface. This theme is not a dimmed dark theme; it is designed from the paper up."
                }
              }
            ],
            "type": "card",
            "props": {
              "padding": 14,
              "color": "#FFFDF7",
              "gap": 8
            }
          },
          {
            "type": "text",
            "props": {
              "size": 14,
              "text": "If you need a darker interface at night, use Night Shift or a dark theme. Papercut is deliberately a daylight palette."
            }
          }
        ],
        "type": "column",
        "props": {
          "padding": 16,
          "gap": 12
        }
