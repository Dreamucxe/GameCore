<?xml version="1.0" encoding="utf-8"?>
<!--
  Glitch slot foreground: the mark split into its two channels.

  A red copy sits 3dp left of centre, a cyan copy 3dp right, and a pale core holds the middle. That
  is the same trick the in-app GlitchLayer uses on panels — two offset copies under one sharp
  original — reduced to something that still reads at 24dp, where a real tear would be one pixel of
  mud.

  Two fracture rules cross the icon at band boundaries, in the theme's own cyan and red, so the slot
  is recognisably the True Glitch identity rather than "the blue one".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Red channel, displaced left. -->
    <group android:translateX="-3">
        <path
            android:fillColor="#FF0055"
            android:pathData="M54,26.5c15.19,0 27.5,12.31 27.5,27.5S69.19,81.5 54,81.5S26.5,69.19 26.5,54S38.81,26.5 54,26.5zM54,31.5c-12.43,0 -22.5,10.07 -22.5,22.5S41.57,76.5 54,76.5S76.5,66.43 76.5,54S66.43,31.5 54,31.5z" />
        <path
            android:fillColor="#FF0055"
            android:pathData="M52.2,16h3.6v10h-3.6zM52.2,82h3.6v10h-3.6zM16,52.2h10v3.6h-10zM82,52.2h10v3.6h-10z" />
    </group>

    <!-- Cyan channel, displaced right. -->
    <group android:translateX="3">
        <path
            android:fillColor="#00F0FF"
            android:pathData="M54,26.5c15.19,0 27.5,12.31 27.5,27.5S69.19,81.5 54,81.5S26.5,69.19 26.5,54S38.81,26.5 54,26.5zM54,31.5c-12.43,0 -22.5,10.07 -22.5,22.5S41.57,76.5 54,76.5S76.5,66.43 76.5,54S66.43,31.5 54,31.5z" />
        <path
            android:fillColor="#00F0FF"
            android:pathData="M52.2,16h3.6v10h-3.6zM52.2,82h3.6v10h-3.6zM16,52.2h10v3.6h-10zM82,52.2h10v3.6h-10z" />
    </group>

    <!-- The sharp original: the part that still reads if the split is lost at small sizes. -->
    <path
        android:fillColor="#E8FBFF"
        android:pathData="M54,38l13.86,8v16L54,70l-13.86,-8v-16zM54,46.5l-6.5,3.75v7.5l6.5,3.75l6.5,-3.75v-7.5z" />

    <!-- Fracture rules, one per channel colour. -->
    <path android:fillColor="#00F0FF" android:pathData="M20,43h68v1.4h-68z" />
    <path android:fillColor="#FF0055" android:pathData="M20,64h68v1.4h-68z" />
</vector>
