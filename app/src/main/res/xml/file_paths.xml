<?xml version="1.0" encoding="utf-8"?>
<!--
  Screenshots and screen recordings are written inside the app's own storage and
  shared out as content URIs with a one-shot read grant. That is why GameCore asks
  for no storage permission on any API level: a file:// path would need one, a
  content:// URI does not.

  files-path rather than cache-path for captures: the platform reclaims cache
  directories under storage pressure without asking, and a screenshot the user
  took deliberately should not be a candidate for that.
-->
<paths>
    <files-path
        name="captures"
        path="captures/" />
    <files-path
        name="recordings"
        path="recordings/" />
    <files-path
        name="exports"
        path="exports/" />
    <files-path
        name="diagnostics"
        path="exports/diagnostics/" />
    <files-path
        name="aimlab"
        path="exports/aimlab/" />
    <files-path
        name="cards"
        path="cards/" />
    <!-- Session receipts are written to the cache, because they are regenerated on demand from a
         session that is still in the database. Without this root FileProvider.getUriForFile()
         throws on the generated PNG and the share tap closes the app. -->
    <cache-path
        name="receipt-exports"
        path="exports/" />
    <files-path
        name="controller-profiles"
        path="controller-profiles/" />
</paths>
