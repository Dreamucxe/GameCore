<?xml version="1.0" encoding="utf-8"?>
<!--
  The Plugin Maker: a small standalone app that hosts the plugin studio.

  There is no `package` attribute here on purpose. The namespace lives in
  build.gradle.kts (com.gamecore.pluginmaker), which is where AGP 8 wants it;
  the package attribute in the source manifest is rejected by the build.

  The app asks for no permissions. It writes the plugin package through the
  storage access framework, where the user picks the folder and the file name,
  and it reads the installed GameCore through the package manager, which is a
  query and not a grant.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility, and not a permission.

      From API 30 the package manager hides every package an app did not ask
      about. Without this line `getPackageInfo("com.gamecore")` throws
      NameNotFoundException on a phone that has GameCore on it, and the maker
      would tell the user GameCore is not installed when it plainly is. Asking
      to *see* one package is not asking for any access to it: the maker still
      cannot do anything to GameCore, it can only read the version it wants to
      tell the user about.

      The debug build of GameCore installs under a suffixed package id
      (com.gamecore.debug), so it is listed too — otherwise a maker installed
      alongside a debug GameCore would never find it.
    -->
    <queries>
        <package android:name="com.gamecore" />
        <package android:name="com.gamecore.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PluginMaker">

        <!--
          The one activity. Exported because the launcher has to be able to
          start it, and it carries the MAIN/LAUNCHER filter that makes the
          maker appear in the app drawer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PluginMaker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
