              "bold": true
            }
          },
          {
            "type": "text",
            "props": {
              "size": 15,
              "text": "A warm amber-on-black palette with serif type. It is designed to feel quieter at night than a cool blue-white dark theme."
            }
          },
          {
            "children": [
              {
                "type": "text",
                "props": {
